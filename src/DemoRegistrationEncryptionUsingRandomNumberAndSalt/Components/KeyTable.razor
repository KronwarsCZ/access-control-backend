@using Pages
@using ApiShared.Dto.Keys
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@attribute [Authorize]


<MudTable Elevation="0" Items="@FilterData" SortLabel="Sort by" Hover="true" LoadingProgressColor="Color.Default" Outlined="true" Bordered="true" Class="border-solid border-2 mud-border-black pa-4" Striped="true" HorizontalScrollbar="true" Style="background-color: rgb(255,105,180, 0.3)">

    <ToolBarContent>
        <MudSpacer/>
        <MudTextField Immediate="true" TextChanged="@NewData" @bind-Value="@searchString" Placeholder="Search for keys..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
    </ToolBarContent>

    <ColGroup>
        <col />
        <col style="width: 120px"/>
    </ColGroup>
    <HeaderContent>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<KeyResult, object>(x => x.Name)"> Name</MudTableSortLabel>
        </MudTh>
        <MudTh>ID</MudTh>
        <MudTh>Created</MudTh>
        <MudTh>Validity Start</MudTh>
        <MudTh>Validity End</MudTh>
        <MudTh>Edit</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Role Name">@context.Name</MudTd>
        <MudTd DataLabel="ID">@context.Id.ToString()</MudTd>
        <MudTd DataLabel="Created">@context.CreatedUtc.ToString()</MudTd>
        <MudTd DataLabel="Validity Start">@context.Validity.StartUtc.ToString()</MudTd>
        <MudTd DataLabel="Validity End">@context.Validity.EndUtc.ToString()</MudTd>
        <MudTd DataLabel="Edit">
            <MudFab @onclick="@(() => Edit(@context))" Color="Color.Primary" Icon="@Icons.Material.Filled.RemoveRedEye" Size="Size.Small" IconSize="Size.Small"/>
            <MudFab @onclick="@(() => Delete(@context.Id))" Color="Color.Secondary" Icon="@Icons.Material.Filled.Delete" Size="Size.Small" IconSize="Size.Small"/>
        </MudTd>
    </RowTemplate>
</MudTable>
<style>
    .mud-table-striped tbody tr:nth-child(even) {
        background-color: rgb(147,112,219, 0.3);
    }
</style>

@code {

    [CascadingParameter]
    public Keys Parent { get; set; }

    [Parameter] public IEnumerable<KeyResult> Data { get; set; }

    [Parameter] public IEnumerable<KeyResult> FilterData { get; set; }


    string searchString = string.Empty;
    
    private async Task Edit(KeyResult key)
    {
        await Parent.ShowRolesForKey(key.Id);
        @*Sends to a new page probably, think about different aproach*@

    }

    private async Task Delete(Guid id)
    {
        var loginUir = new Uri("api/v1/keys/deleteKey", UriKind.Relative);
        var payload = new KeyDeleteParameters() { KeyId = id };
        var client = HttpClientFactory.CreateClient("client");
        var response = await HttpHelpers.CallEndpoint<KeyDeleteParameters, KeyDeleteResult>(client, loginUir, HttpHelpers.HttpMethod.Post, payload);
        NavigationManager.NavigateTo("/Keys", forceLoad: true);
        Snackbar.Add("Key successfully deleted.", Severity.Success);
    }

    void NewData()
    {
        FilterData = Data.Where(x => x.Name.ToLower().Contains(searchString.ToLower())).ToList();
        StateHasChanged();
    }

    #region IDisposable

    private readonly CancellationTokenSource _cts = new();
    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    #endregion
}