@page "/Roles"
@using ApiShared.Dto.Roles
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@using DemoRegistrationEncryptionUsingRandomNumberAndSalt.Components
@attribute [Authorize]
<h3>Roles</h3>



<MudGrid>
    <MudItem xs="6">
        <MudTextField T="string" Label="Role Name" @bind-Value="@createRoleText"></MudTextField>
    </MudItem>
    <MudItem xs="6" Class="pa-8">
<MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Style="background-color: rgb(147,112,219, 0.3)" OnClick="@CheckNewRoleName">Create Role</MudButton> @* Make it so names have to be unique*@
    </MudItem>
</MudGrid>
<br/>
<br/>
@*
    <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"/>
    <MudFab Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Cancel" OnClick="@ChangeVisibilityCreateButton" />
*@

@*This should allow to edit specific role*@
<MudGrid>
    <MudItem xs="12">
        <MudGrid Justify="Justify.FlexStart">
            <MudItem xs="8">
                <CascadingValue Value="@this">
                    <RoleTable Data="@roles" FilterData="@filterData"></RoleTable>
                    </CascadingValue>
            </MudItem>
        </MudGrid>
    </MudItem>

</MudGrid>
@code {
    [CascadingParameter]
    public Task<AuthenticationState> AuthState { get; set; }
    
    string createRoleText = String.Empty;
    IEnumerable<RoleResult> filterData;
    private IEnumerable<RoleResult> roles;


    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;

        if (user!.Identity!.IsAuthenticated)
            await LoadPageAsync();
        else
            await base.OnInitializedAsync();
    }

    public async Task GetRoles()
    {
        var loginUir = new Uri("api/v1/roles/getAllRoles", UriKind.Relative);
        var payload = new GetAllRolesParameters();
        var client = HttpClientFactory.CreateClient("client");
        var response = await HttpHelpers.CallEndpoint<GetAllRolesParameters, GetAllRolesResult>(client, loginUir, HttpHelpers.HttpMethod.Post, payload);
        roles = response.DeserializedResponse.Roles;    
        filterData = roles;
    }
    
    public async Task RefreshState()
    {
        await GetRoles();
        StateHasChanged();
    }

    async Task CheckNewRoleName()
    {
        if (createRoleText == string.Empty)
        {
            return;
        }
        var x = roles.FirstOrDefault(x => x.Name == createRoleText);
            if (x is null)
            {
                await CreateRole();
            }

    }
    
    public async Task LoadPageAsync()
    {
        await GetRoles();
    }

    async Task CreateRole()
    {
        var loginUir = new Uri("api/v1/roles/addNewRole", UriKind.Relative);
        var payload = new RoleAddParameters(){Name = createRoleText};
        var client = HttpClientFactory.CreateClient("client");
        var response = await HttpHelpers.CallEndpoint<RoleAddParameters, RoleAddResult>(client, loginUir, HttpHelpers.HttpMethod.Post, payload);

        await GetRoles();
        StateHasChanged();
    }

    #region IDisposable

    private readonly CancellationTokenSource _cts = new();

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    #endregion
}