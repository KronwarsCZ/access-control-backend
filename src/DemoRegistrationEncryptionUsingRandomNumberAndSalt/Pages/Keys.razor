@page "/keys"


@using ApiShared.Dto.Keys
@using ApiShared.Dto.Roles
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@using DemoRegistrationEncryptionUsingRandomNumberAndSalt.Components
@attribute [Authorize]

<PageTitle>Devices</PageTitle>

@if (_keys == null)
{
    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
}
else
{
    <MudGrid>
        <MudItem xs="6">
            <MudTextField T="string" Label="Key Name" @bind-Value="@createKeyText"></MudTextField>
        </MudItem>
        <MudItem xs="6" Class="pa-8">
            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Outlined" OnClick="@CheckNewKeyName">Create Key</MudButton> @* Make it so names have to be unique*@
        </MudItem>
    </MudGrid>
    <br/>
    <br/>

@*This should allow to edit specific role*@
    <MudGrid>
        <MudItem xs="12">
            <MudGrid Justify="Justify.FlexStart">
                <MudItem xs="6">
                    <CascadingValue Value="@this">
                        <KeyTable Data="@_keys" FilterData="@filterData"></KeyTable>
                    </CascadingValue>

                </MudItem>
            </MudGrid>
        </MudItem>

    </MudGrid>
}



@code {
    
    
    [CascadingParameter]
    public Task<AuthenticationState> AuthState { get; set; }

    IEnumerable<KeyResult> filterData;
    private IEnumerable<KeyResult> _keys;
    string createKeyText = String.Empty;
    
    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;

        if (user!.Identity!.IsAuthenticated)
            await LoadPageAsync();
        else
            await base.OnInitializedAsync();
    }


    public async Task LoadPageAsync()
    {
        var loginUir = new Uri("api/v1/keys/getAllKeys", UriKind.Relative);
        var payload = new GetAllKeysParameters();
        var client = HttpClientFactory.CreateClient("client");
        var response = await HttpHelpers.CallEndpoint<GetAllKeysParameters, GetAllKeysResult>(client, loginUir, HttpHelpers.HttpMethod.Post, payload);
        _keys = response.DeserializedResponse.Keys;
    }

    
    async Task CheckNewKeyName()
    {
        if (createKeyText == string.Empty)
        {
            return;
        }
        var x = _keys.FirstOrDefault(x => x.Name == createKeyText);
        if (x is null)
        {
            await CreateKey();
        }
    }
    
    async Task CreateKey()
    {
        var loginUir = new Uri("api/v1/keys/issueNewKey", UriKind.Relative);
        var role = new AttachRoleToDeviceParameters();
        var payload = new RoleAddParameters(){Name = createKeyText};
        var client = HttpClientFactory.CreateClient("client");
        var response = await HttpHelpers.CallEndpoint<IssueNewKeyParameters, IssueNewKeyResult>(client, loginUir, HttpHelpers.HttpMethod.Post, payload);

        await LoadPageAsync();
        StateHasChanged();
    }
    

    #region IDisposable

    private readonly CancellationTokenSource _cts = new();

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    #endregion

}