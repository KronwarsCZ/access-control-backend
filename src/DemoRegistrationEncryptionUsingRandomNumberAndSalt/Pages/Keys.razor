@page "/keys"


@using ApiShared.Dto.Keys
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@attribute [Authorize]

<PageTitle>Devices</PageTitle>

@if (_keys == null)
{
    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
}
else
{
    <MudTable Items="_keys" Hover="true" SortLabel="Sort By" Elevation="0">
        <HeaderContent>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<DeviceResult, object>(x => x.Id)">Identifier</MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<DeviceResult, object>(x => x.Name)">Name</MudTableSortLabel>
            </MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Identifier">@context.Id</MudTd>
            <MudTd DataLabel="Name">@context.Name</MudTd>
        </RowTemplate>

        <PagerContent>
            <MudTablePager PageSizeOptions="new [] { 50, 100 }"/>
        </PagerContent>
    </MudTable>
}



@code {
    
    
    [CascadingParameter]
    public Task<AuthenticationState> AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;

        if (user!.Identity!.IsAuthenticated)
            await LoadPageAsync();
        else
            await base.OnInitializedAsync();
    }

    private async Task LoadPageAsync()
    {
        var loginUir = new Uri("api/v1/keys/getAllKeys", UriKind.Relative);
        var payload = new GetAllKeysParameters();
        var client = HttpClientFactory.CreateClient("client");
        var response = await HttpHelpers.CallEndpoint<GetAllKeysParameters, GetAllKeysResult>(client, loginUir, HttpHelpers.HttpMethod.Post, payload);
        _keys = response.DeserializedResponse.Keys;
    }

    private IEnumerable<KeyResult> _keys;
    

    #region IDisposable

    private readonly CancellationTokenSource _cts = new();

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    #endregion

}