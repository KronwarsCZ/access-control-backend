@page "/register"
@using System.ComponentModel.DataAnnotations
@using ApiShared.Dto.Owners
@inject ISnackbar Snackbar
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@attribute [AllowAnonymous]
@layout EmptyLayout

<PageTitle>Register</PageTitle>


<EditForm Model="@_model" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator/>
    <MudCardContent>
        <MudTextField Label="Account name" HelperText="Max. 32 characters"@bind-Value="_model.Accountname" For="@(() => _model.Accountname)"/>
        <MudTextField Label="Email" HelperText="Enter your email address" Class="mt-3"@bind-Value="_model.Email" For="@(() => _model.Email)"/>
        <MudTextField Label="Password" HelperText="Choose a strong password" Class="mt-3"@bind-Value="_model.Password" For="@(() => _model.Password)" InputType="InputType.Password"/>
        <MudTextField Label="Password" HelperText="Repeat the password" Class="mt-3"@bind-Value="_model.Password2" For="@(() => _model.Password2)" InputType="InputType.Password"/>
    </MudCardContent>
    <MudCardActions>
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto">Register</MudButton>
    </MudCardActions>
</EditForm>


<MudLink Href="/login">
    <MudText >Already have an account?</MudText>
</MudLink>

@code {
    [CascadingParameter]
    public Task<AuthenticationState> AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;

        if (user!.Identity!.IsAuthenticated)
            NavigationManager.NavigateTo("/");
        else
            await base.OnInitializedAsync();
    }
    
    readonly RegisterAccountForm _model = new();

    public class RegisterAccountForm
    {
        [Required]
        [StringLength(32, ErrorMessage = "Name length can't be more than 8.")]
        public string Accountname { get; set; }

        [Required]
        [EmailAddress]
        [StringLength(32, ErrorMessage = "Name length can't be more than 8.")]
        public string Email { get; set; }

        [Required]
        [StringLength(64, ErrorMessage = "Password must be at least 8 characters long.", MinimumLength = 8)]
        public string Password { get; set; }

        [Compare(nameof(Password))]
        public string Password2 { get; set; }
    }

    private async Task OnValidSubmit(EditContext context)
    {
        var loginUir = new Uri("api/v1/registerNewOwner", UriKind.Relative);
        var payload = new RegisterNewOwnerParameters
        {
            Email = _model.Email,
            Password = _model.Password,
            Name = _model.Accountname
        };
        var client = HttpClientFactory.CreateClient("client");
        var response = await HttpHelpers.CallEndpoint<RegisterNewOwnerParameters, RegisterNewOwnerResponse>(client, loginUir, HttpHelpers.HttpMethod.Post, payload);
        

        if (response.HttpResponse.IsSuccessStatusCode)
        {
            SnackbarNotification("Registration successful, confirm your email address.", Severity.Success);
            NavigationManager.NavigateTo("/login");
        }
        else
        {
            SnackbarNotification("Email is already used.", Severity.Error);
        }
    }

    private void SnackbarNotification(string message, Severity severity)
    {
        Snackbar.Add(message, severity);
    }
    
    #region IDisposable

    private readonly CancellationTokenSource _cts = new();

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    #endregion
}