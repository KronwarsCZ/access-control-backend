@using AccessControl.Web.BlazorUI.ErrorHandling
@inject NavigationManager NavigationManager
@using AccessControl.Web.BlazorUI.Components
@inherits LayoutComponentBase

<MudThemeProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<AuthorizeView>
    <Authorized>
        <Redirect Page="" IsAuthorized="true"/>
    </Authorized>
    <NotAuthorized>
        <MudLayout>
            <MudMainContent>
                <MudContainer Fixed="true" Class="my-16 pt-16">
                    <CustomErrorBoundary @ref="_customErrorBoundary">
                        <ChildContent>
                            @Body
                        </ChildContent>
                        <ErrorContent Context="ex">
                            <div>An error has occured and we have been notified and are working on a fix. Please try later.</div>
                        </ErrorContent>
                    </CustomErrorBoundary>
                </MudContainer>
            </MudMainContent>
        </MudLayout>
    </NotAuthorized>
</AuthorizeView>


@code {

    private CustomErrorBoundary _customErrorBoundary;
}