@using AccessControl.Web.BlazorUI.ErrorHandling
@inject NavigationManager NavigationManager
@inherits LayoutComponentBase
@using AccessControl.Web.BlazorUI.Components

<MudThemeProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@DrawerToggle"/>
        <MudLink Href="/" Class="pa-4 mud-theme-primary" Underline="Underline.None" Typo="Typo.h5">Access Control App</MudLink >
        <MudSpacer/>
        <AuthorizeView>
            <Authorized>
                <MudButton Variant="Variant.Text" Class="shades-text text-white" Size="Size.Small" DisableElevation="true" OnClick="@LogOut">Logout</MudButton>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <AccessControlNavMenu></AccessControlNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-16 pt-16">
            <CustomErrorBoundary @ref="_customErrorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="ex">
                    <div>An error has occured and we have been notified and are working on a fix. Please try later.</div>
                </ErrorContent>
            </CustomErrorBoundary>
        </MudContainer>
    </MudMainContent>


</MudLayout>

<Logout @ref="logout"/>
@code {

    private CustomErrorBoundary _customErrorBoundary;

    bool _drawerOpen = true;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private Logout logout;
    
    private void LogOut()
    {
        logout.LogoutUser();
    }
}