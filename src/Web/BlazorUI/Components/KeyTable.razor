@using AccessControl.Web.BlazorUI.Pages
@using Application.IRepositories.Keys
@using Application.Services
@using Application.Services.Keys
@using Core.Entities
@using Core.Entities.Keys
@using Core.Entities.Roles
@using Framework.Extensions
@inject NavigationManager NavigationManager
@inject IKeyService KeyRepository


<MudTable Elevation="0" Items="@FilterData" SortLabel="Sort by" Hover="true" LoadingProgressColor="Color.Default" Outlined="true" Bordered="true" Class="border-solid border-2 mud-border-black pa-4">

    <ToolBarContent>
        <MudSpacer/>
        <MudTextField Immediate="true" TextChanged="@NewData" @bind-Value="@searchString" Placeholder="Search for keys..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
    </ToolBarContent>

    <ColGroup>
        <col />
        <col style="width: 120px"/>
    </ColGroup>
    <HeaderContent>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<Role, object>(x => x.Name)"> Name</MudTableSortLabel>
        </MudTh>
        <MudTh>Edit</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Role Name">@context.Name</MudTd>
        <MudTd DataLabel="Edit">
            <MudFab @onclick="@(() => Edit(@context))" Color="Color.Primary" Icon="@Icons.Material.Filled.Edit" Size="Size.Small" IconSize="Size.Small"/>
            <MudFab @onclick="@(() => Delete(@context.Id))" Color="Color.Secondary" Icon="@Icons.Material.Filled.Delete" Size="Size.Small" IconSize="Size.Small"/>
        </MudTd>
    </RowTemplate>
</MudTable>

@code {

    [CascadingParameter]
    public Keys Parent { get; set; }

    [Parameter] public IEnumerable<Key> Data { get; set; }

    [Parameter] public IEnumerable<Key> FilterData { get; set; }


    string searchString = string.Empty;
    public async Task Edit(Key key)
    {
        @*Sends to a new page probably, think about different aproach*@
        await Parent.RefreshState();

    }

    public async Task Delete(Guid id)
    {

        var key = Data.First(x => x.Id == id);
        await KeyRepository.DeleteAsync(key, _cts.Token);
        await Parent.RefreshState();
    }

    void NewData()
    {
        FilterData = Data.Where(x => x.Name.ToLower().Contains(searchString.ToLower())).ToList();
        StateHasChanged();
    }

    #region IDisposable

    private readonly CancellationTokenSource _cts = new();
    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    #endregion
}