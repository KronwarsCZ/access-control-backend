@page "/Roles"
@using AccessControl.Web.BlazorUI.Components
@using Application.Services
@using Core.Entities
@inject IRoleService RoleService
@inject NavigationManager NavigationManager
@using Framework.Extensions
<h3>Roles</h3>



<MudGrid>
    <MudItem xs="6">
        <MudTextField T="string" Label="Role Name" @bind-Value="@CreateRoleText"></MudTextField>
    </MudItem>
    <MudItem xs="6" Class="pa-8">
<MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Outlined" OnClick="@CheckNewRoleName">Create Role</MudButton> @* Make it so names have to be unique*@
    </MudItem>
</MudGrid>
<br/>
<br/>
@*
    <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"/>
    <MudFab Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Cancel" OnClick="@ChangeVisibilityCreateButton" />
*@

@*This should allow to edit specific role*@
<MudGrid>
    <MudItem xs="12">
        <MudGrid Justify="Justify.FlexStart">
            <MudItem xs="6">
                @if (GetRoles() == null)
                {
                    <MudProgressCircular Color="Color.Default" Indeterminate="true"/>
                }
                else
                {
                    <CascadingValue Value="@this">
                    <RoleTable Data="@roles" FilterData="@filterData"></RoleTable>
                    </CascadingValue>
                @*Here should be list of all roles that account has access to*@
                }

            </MudItem>
        </MudGrid>
    </MudItem>

</MudGrid>
@code {
    string CreateRoleText = String.Empty;
    IEnumerable<Role> filterData;
    
    private IEnumerable<Role> roles;

    protected override async Task OnInitializedAsync()
    {
        await GetRoles();
    }

    public async Task GetRoles()
    {
        roles = await RoleService.GetAllAsync(_cts.Token);
        filterData = roles;
    }
    
    public async Task RefreshState()
    {
        await GetRoles();
        StateHasChanged();
    }

    async Task CheckNewRoleName()
    {
        if (CreateRoleText == string.Empty)
        {
            return;
        }
        var x = roles.Where(x => x.Name == CreateRoleText).FirstOrDefault();
            if (x is null)
            {
                await CreateRole();
                NavigationManager.NavigateTo("roles", true);
            }

    }

    async Task CreateRole()
    {
        var newRole = RoleService.Create(CreateRoleText);
        CreateRoleText = string.Empty;
        var newRoleEnumerable = newRole.ToEnumerable();
        await RoleService.AddAsync(newRoleEnumerable, _cts.Token);
        StateHasChanged();
    }

    #region IDisposable

    private readonly CancellationTokenSource _cts = new();

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    #endregion
}