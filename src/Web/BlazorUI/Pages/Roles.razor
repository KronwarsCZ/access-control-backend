@page "/Roles"
@using AccessControl.Web.BlazorUI.Components
@using Application.Services.Owners
@using Application.Services.Roles
@using Core.Entities
@using Core.Entities.Owners
@using Core.Entities.Roles
@using Framework.Extensions
@inject IRoleService RoleService
@inject IOwnerService OwnerService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider GetAuthenticationStateAsync
<h3>Roles</h3>



<MudGrid>
    <MudItem xs="6">
        <MudTextField T="string" Label="Role Name" @bind-Value="@CreateRoleText"></MudTextField>
    </MudItem>
    <MudItem xs="6" Class="pa-8">
<MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Outlined" OnClick="@CheckNewRoleName">Create Role</MudButton> @* Make it so names have to be unique*@
    </MudItem>
</MudGrid>
<br/>
<br/>
@*
    <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"/>
    <MudFab Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Cancel" OnClick="@ChangeVisibilityCreateButton" />
*@

@*This should allow to edit specific role*@
<MudGrid>
    <MudItem xs="12">
        <MudGrid Justify="Justify.FlexStart">
            <MudItem xs="6">
                <CascadingValue Value="@this">
                    <RoleTable Data="@roles" FilterData="@filterData"></RoleTable>
                    </CascadingValue>
            </MudItem>
        </MudGrid>
    </MudItem>

</MudGrid>
@code {
    string CreateRoleText = String.Empty;
    IEnumerable<Role> filterData;
    
    private IEnumerable<Role> roles;



    async Task GetRolesForOwner()
    {
        List<Role> allOwnerRoles = new List<Role>();
        @*get mail of user*@
        var user = await GetAuthenticationStateAsync.GetAuthenticationStateAsync();
        Owner owner = null; @* get owner*@
        foreach (var area in owner.Areas)
        {
            foreach (var building in area.Buildings)
            {
                allOwnerRoles.AddRange(building.Roles);
            }
        }
    }
    

    protected override async Task OnInitializedAsync()
    {
        await GetRoles();
    }

    public async Task GetRoles()
    {
        roles = await RoleService.GetAllAsync(_cts.Token);
        filterData = roles;
    }
    
    public async Task RefreshState()
    {
        await GetRoles();
        StateHasChanged();
    }

    async Task CheckNewRoleName()
    {
        if (CreateRoleText == string.Empty)
        {
            return;
        }
        var x = roles.FirstOrDefault(x => x.Name == CreateRoleText);
            if (x is null)
            {
                await CreateRole();
                NavigationManager.NavigateTo("roles", true);
            }

    }

    async Task CreateRole()
    {
        // toto ted nemusi fungovat protoze se tam vytvari novy owner co nemusi byt navazany na db
        var newRole = Role.Create(Owner.Create("sample owner"), CreateRoleText);
        CreateRoleText = string.Empty;
        var newRoleEnumerable = newRole.ToEnumerable();
        
        await RoleService.AddAsync(newRoleEnumerable, _cts.Token);
        StateHasChanged();
    }

    #region IDisposable

    private readonly CancellationTokenSource _cts = new();

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    #endregion
}