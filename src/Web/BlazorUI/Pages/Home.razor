@page "/"
<PageTitle>Home</PageTitle>

<MudText Typo="Typo.h3">Welcome to home page</MudText>

<br/>
<br/>
<MudGrid>
    <MudItem xs="4">
        <MudButton Href="/Devices" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Memory" Color="Color.Secondary" FullWidth="true">Go to Devices</MudButton>
    </MudItem>
    <MudItem xs="4">
        <MudButton Href="/Keys" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Key" Color="Color.Secondary" FullWidth="true">Go to Keys</MudButton>
    </MudItem>
    <MudItem xs="4">
        <MudButton Href="/Roles" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PeopleAlt" Color="Color.Secondary" FullWidth="true">Go to Roles</MudButton>
    </MudItem>
</MudGrid>
    <MudSpacer/>
<MudGrid Class="mb-n12 mx-auto pa-6" Spacing="5">
    <MudItem xs="2">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ManageAccounts" Color="Color.Secondary" FullWidth="true">Manage Accounts</MudButton>
    </MudItem>
    <MudItem xs="2">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.SwitchAccount" Color="Color.Secondary" FullWidth="true">Switch Accounts</MudButton>
    </MudItem>
    <MudItem xs="2">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Create" Color="Color.Secondary" FullWidth="true">Create Reservation</MudButton>
    </MudItem>
</MudGrid>


@code
{
    [CascadingParameter]
    private Task<AuthenticationState> authenticationState { get; set; }


}