@page "/Statistics"
@using System.Globalization
@using Application.Services.Devices
@using Application.Services.Keys
@using Application.Services.Roles
@using Core.Entities.Devices
@using Core.Entities.Keys
@using Core.Entities.Roles
@inject IRoleService RoleService
@inject IKeyService KeyService
@inject IDeviceService DeviceService

<h3>Statistics</h3>
<MudGrid>
	<MudItem xs="4">
		<MudChart ChartType="ChartType.Donut" Width="250px" Height="250px" InputData="@dataDevices" InputLabels="@labelsDevices">
			<CustomGraphics>
				<text class="donut-inner-text" x="50%" y="35%" dominant-baseline="middle" text-anchor="middle" fill="black" font-family="Helvetica" font-size="3">Total</text>
				<text class="donut-inner-text" x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="black" font-family="Helvetica" font-size="5">@devicesCount.ToString(CultureInfo.InvariantCulture)</text>
			</CustomGraphics>
		</MudChart>
	</MudItem>
	
	<MudItem xs="4">
		<MudChart ChartType="ChartType.Donut" Width="250px" Height="250px" InputData="@dataRoles" InputLabels="@labelsRoles">
			<CustomGraphics>
				<text class="donut-inner-text" x="50%" y="35%" dominant-baseline="middle" text-anchor="middle" fill="black" font-family="Helvetica" font-size="3">Total</text>
				<text class="donut-inner-text" x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="black" font-family="Helvetica" font-size="5">@rolesCount.ToString(CultureInfo.InvariantCulture)</text>
			</CustomGraphics>
		</MudChart>

	</MudItem>
	<MudItem xs="4">

		<MudChart ChartType="ChartType.Donut" Width="250px" Height="250px" InputData="@dataKeys" InputLabels="@labelsKeys">
			<CustomGraphics>
				<text class="donut-inner-text" x="50%" y="35%" dominant-baseline="middle" text-anchor="middle" fill="black" font-family="Helvetica" font-size="3">Total</text>
				<text class="donut-inner-text" x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="black" font-family="Helvetica" font-size="5">@keysCount.ToString(CultureInfo.InvariantCulture)</text>
			</CustomGraphics>
		</MudChart>
	</MudItem>
	
	@*Overtime line charts*@
	
	<MudItem xs="4">
		<MudChart ChartType="ChartType.Line" ChartSeries="@SeriesDevices" XAxisLabels="@XAxisLabelsDevices" Width="100%" Height="250" ChartOptions="deviceOptions"></MudChart>
	</MudItem>
	<MudItem xs="4">
		<MudChart ChartType="ChartType.Line" ChartSeries="@SeriesRoles" XAxisLabels="@XAxisLabelsRoles" Width="100%" Height="250" ChartOptions="roleOptions"></MudChart>
	</MudItem>
	<MudItem xs="4">
		<MudChart ChartType="ChartType.Line" ChartSeries="@SeriesKeys" XAxisLabels="@XAxisLabelsKeys" Width="100%" Height="250" ChartOptions="keyOptions"></MudChart>
	</MudItem>
</MudGrid>




@code {
	IEnumerable<Role> roles;
	double rolesCount { get; set; }
	public double[] dataRoles;
	public string[] labelsRoles = { "Roles" };
	
	IEnumerable<Key> keys;
	double keysCount { get; set; }
	public double[] dataKeys;
	public string[] labelsKeys = { "Keys" };
	
	IEnumerable<Device> devices;
	double devicesCount { get; set; }
	public double[] dataDevices;
	public string[] labelsDevices = { "Devices" };


	protected override async Task OnInitializedAsync()
	{
		roles = await RoleService.GetAllAsync(_cts.Token);
		rolesCount = roles.Count();

		keys = await KeyService.GetAllAsync(_cts.Token);
		keysCount = keys.Count();
		
		devices = await DeviceService.GetAllAsync(_cts.Token);
		devicesCount = devices.Count();

		deviceOptions.InterpolationOption = InterpolationOption.Periodic;
		SeriesDevices[0].Data[SeriesDevices[0].Data.Count()-1] = devicesCount;
		
		roleOptions.InterpolationOption = InterpolationOption.Periodic;
		SeriesRoles[0].Data[SeriesRoles[0].Data.Count()-1] = rolesCount;
		
		keyOptions.InterpolationOption = InterpolationOption.NaturalSpline;
		SeriesKeys[0].Data[SeriesKeys[0].Data.Count()-1] = keysCount;
	}
	public Statistics()
	{
		dataRoles = new[] { rolesCount };
		dataKeys = new[] { keysCount };
		dataDevices = new[] { devicesCount };
	}

	ChartOptions deviceOptions = new ChartOptions();
	public List<ChartSeries> SeriesDevices = new List<ChartSeries>()
	{
		new ChartSeries() { Name = "Devices", Data = new double[] { 6,10,7,3,4,8,5} }
	};
	public string[] XAxisLabelsDevices = { "Mon", "Tue", "Wen", "Thu", "Fri", "Sat", "Sun" };
	
	
	
	ChartOptions roleOptions = new ChartOptions();
	public List<ChartSeries> SeriesRoles = new List<ChartSeries>()
	{
		new ChartSeries() { Name = "Roles", Data = new double[] { 1,2,3,4,5} }
	};
	public string[] XAxisLabelsRoles = { "Mon", "Tue", "Wen", "Thu", "Fri", "Sat", "Sun" };
	
	
	
	ChartOptions keyOptions = new ChartOptions();
	public List<ChartSeries> SeriesKeys = new List<ChartSeries>()
	{
		new ChartSeries() { Name = "Keys", Data = new double[] { 0,0,0,0} }
	};
	public string[] XAxisLabelsKeys = { "Mon", "Tue", "Wen", "Thu", "Fri", "Sat", "Sun" };

	
	#region IDisposable

	private readonly CancellationTokenSource _cts = new();


	public void Dispose()
	{
		_cts.Cancel();
		_cts.Dispose();
	}

	#endregion
}