@page "/login"
@inject IAccountService AccountService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@implements IDisposable
@using System.ComponentModel.DataAnnotations
@using AccessControl.Web.Authentication
@using Application.Services
@using AccessControl.Web.BlazorUI.Components
@using Account = Core.Entities.Account
@inject ISnackbar Snackbar

@attribute [AllowAnonymous]
<PageTitle>Login</PageTitle>

<LoginRedirect/>

<EditForm Model="@model" OnValidSubmit="Authenticate">
    <DataAnnotationsValidator/>
    <MudGrid>
        <MudItem xs="12" sm="7">
            <MudCard>
                <MudCardContent>
                    <MudTextField Label="Email" Class="mt-3"@bind-Value="model.Email" For="@(() => model.Email)"/>
                    <MudTextField Label="Password" HelperText="Enter your password" Class="mt-3"@bind-Value="model.Password" For="@(() => model.Password)" InputType="InputType.Password"/>
                </MudCardContent>
                <MudCardActions>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto">Login</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</EditForm>

<MudLink Href="/register">
    <MudText >Dont have an account yet?</MudText>
</MudLink>

@code {

    LoginAccountFormModel model = new();

    public class LoginAccountFormModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; }

        [Required]
        [StringLength(64, MinimumLength = 8)]
        public string Password { get; set; }
    }

    private async Task Authenticate()
    {
        var userAccount = await AccountService.GetAccountByEmailAsync(model.Email, _cts.Token);

        if (IsUserInputValid(userAccount))
        {
            await SetAuthState(userAccount);
        }
        else
        {
            DisplayEmailOrPasswordIncorrect();
        }
    }

    private void DisplayEmailOrPasswordIncorrect()
    {
        Snackbar.Add("Email or password is incorrect.", Severity.Error);
    }

    private bool IsUserInputValid(Account account)
    {
        return account is not null && AccountService.IsPasswordCorrect(model.Password, account);
    }

    private async Task SetAuthState(Account account)
    {
        var customAuthStateProvider = AuthenticationStateProvider as CustomAuthenticationStateProvider;
        await customAuthStateProvider.UpdateAuthenticationState(new AccountSession
        {
            AccountName = account.Email,
            Role = account.Role.ToString()
        });
        NavigationManager.NavigateTo("/", true);
    }

    #region IDisposable

    private readonly CancellationTokenSource _cts = new();

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    #endregion

}