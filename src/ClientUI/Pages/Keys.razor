@page "/keys"
@using ApiShared.Dto.Keys
@using ApiShared.Dto.Roles
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@using DemoRegistrationEncryptionUsingRandomNumberAndSalt.Components
@inject IDialogService DialogService
@attribute [Authorize]

<PageTitle>Keys</PageTitle>

@if (_keys == null)
{
    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-4 mb-6 d-flex align-center" Elevation="2" Style="background-color: rgb(255,105,180, 0.15)">
        <MudText Typo="Typo.h6">Keys</MudText>
        <MudSpacer />
        <MudButton StartIcon="@Icons.Material.Filled.Add"
                   Variant="Variant.Filled"
                   Style="background-color: rgb(255,105,180, 0.5)"
                   OnClick="OpenIssueKeyDialog">
            Issue New Key
        </MudButton>
    </MudPaper>

    <CascadingValue Value="@this">
        <KeyTable Data="@_keys" FilterData="@filterData"></KeyTable>
    </CascadingValue>
}

@code {
    [CascadingParameter]
    public Task<AuthenticationState> AuthState { get; set; }

    IEnumerable<KeyResult> filterData { get; set; }
    private IEnumerable<KeyResult> _keys { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;

        if (user!.Identity!.IsAuthenticated)
            await LoadPageAsync();
        else
            await base.OnInitializedAsync();
    }

    public async Task RefreshState()
    {
        await LoadPageAsync();
        StateHasChanged();
    }

    public async Task LoadPageAsync()
    {
        filterData = new List<KeyResult>();
        var client = HttpClientFactory.CreateClient("client");

        var keysResponse = await HttpHelpers.CallEndpoint<GetAllKeysParameters, GetAllKeysResult>(
            client, new Uri("api/v1/keys/getAllKeys", UriKind.Relative), HttpHelpers.HttpMethod.Post, new GetAllKeysParameters());

        _keys = keysResponse.DeserializedResponse.Keys;
        filterData = _keys;
    }

    async Task OpenIssueKeyDialog()
    {
        var parameters = new DialogParameters<IssueKeyDialog>
        {
            { x => x.ExistingKeys, _keys ?? Enumerable.Empty<KeyResult>() }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<IssueKeyDialog>("Issue New Key", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await RefreshState();
        }
    }

    #region IDisposable

    private readonly CancellationTokenSource _cts = new();

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    #endregion
}
