@page "/keys"
@using ApiShared.Dto.Keys
@using ApiShared.Dto.Roles
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@using DemoRegistrationEncryptionUsingRandomNumberAndSalt.Components
@inject ISnackbar Snackbar
@attribute [Authorize]

<PageTitle>Devices</PageTitle>

@if (_keys == null)
{
    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
}
else
{
    <MudGrid>
        <MudItem xs="7">
            <MudTextField T="string" Label="Key Name" @bind-Value="@createKeyText"></MudTextField>
        </MudItem>
        <MudItem xs="7">
            <MudTextField T="string" Label="Key UID (hex from keycard, e.g. AABBCCDD)" @bind-Value="@createKeyUid"></MudTextField>
        </MudItem>
        <MudItem xs="7">
            
        <MudSelect MultiSelection="true" T="string" MultiSelectionTextFunc="new Func<List<string>, string>(GetMultiSelectionText)" bind-SelectedValues="@filterRoles" Label="Roles" AdornmentIcon="@Icons.Material.Filled.Search" AnchorOrigin="Origin.BottomCenter">
            @foreach (var role in roles)
            {
                <MudSelectItem T="string" Value="@role.Id.ToString()">@role.Name</MudSelectItem>
            }
        </MudSelect>
        </MudItem>
        
        <MudItem xs="6" Class="pa-8">
            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Style="background-color: rgb(255,105,180, 0.3)" OnClick="@CheckNewKeyName">Create Key</MudButton>
        </MudItem>
    </MudGrid>
    <br/>
    <br/>
    
    <MudGrid>
        <MudItem xs="12">
            <MudGrid Justify="Justify.FlexStart">


                <CascadingValue Value="@this">
                    @if (!rolesForKeyVisible)
                    {
                        
                        <MudItem xs="8">
                            <KeyTable Data="@_keys" FilterData="@filterData"></KeyTable>
                        </MudItem>
                    }
                    else
                    {
                        
                        <MudItem xs="8">
                            <RolesForKeyTable Data="@keyRoles" FilterData="@filterRoleData"></RolesForKeyTable>
                        </MudItem>
                        <MudButton OnClick="@ShowKeys" Variant="Variant.Filled" Color="Color.Secondary">Back</MudButton>
                    }
                </CascadingValue>


            </MudGrid>
        </MudItem>

    </MudGrid>
}



@code {
    [CascadingParameter]
    public Task<AuthenticationState> AuthState { get; set; }

    IEnumerable<KeyResult> filterData { get; set; }
    private IEnumerable<KeyResult> _keys { get; set; }
    string createKeyText = String.Empty;
    string createKeyUid = String.Empty;


    private IEnumerable<RoleResult> roles { get; set; }
    private IEnumerable<string> filterRoles { get; set; }

    bool rolesForKeyVisible = false;
    private IEnumerable<RoleResult> keyRoles { get; set; }
    IEnumerable<RoleResult> filterRoleData { get; set; }


    public async Task ShowRolesForKey(Guid id)
    {
        var loginUir = new Uri("api/v1/roles/getRolesForKey", UriKind.Relative);
        var payload = new GetRolesForKeyParameters(){KeyId = id};
        var client = HttpClientFactory.CreateClient("client");
        var response = await HttpHelpers.CallEndpoint<GetRolesForKeyParameters, GetAllRolesResult>(client, loginUir, HttpHelpers.HttpMethod.Post, payload);
        keyRoles = response.DeserializedResponse.Roles;
        filterRoleData = keyRoles;
        rolesForKeyVisible = true;
        StateHasChanged();
    }

    public void ShowKeys()
    {
        rolesForKeyVisible = false;
        StateHasChanged();
    }
    

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;

        if (user!.Identity!.IsAuthenticated)
            await LoadPageAsync();
        else
            await base.OnInitializedAsync();
    }


    private string GetMultiSelectionText(List<string> selectedValues )
    {
        filterRoles = selectedValues;
        var count = selectedValues.Count;
        return $"Selected role{(count != 1 ? "s" : "")}: {count}";
    }

    public async Task GetRoles()
    {
        var loginUir = new Uri("api/v1/roles/getAllRoles", UriKind.Relative);
        var payload = new GetAllRolesParameters();
        var client = HttpClientFactory.CreateClient("client");
        var response = await HttpHelpers.CallEndpoint<GetAllRolesParameters, GetAllRolesResult>(client, loginUir, HttpHelpers.HttpMethod.Post, payload);
        roles = response.DeserializedResponse.Roles;
    }


    public async Task LoadPageAsync()
    {
        filterData = new List<KeyResult>();
        filterRoles = new List<string>();
        var loginUir = new Uri("api/v1/keys/getAllKeys", UriKind.Relative);
        var payload = new GetAllKeysParameters();
        var client = HttpClientFactory.CreateClient("client");
        var response = await HttpHelpers.CallEndpoint<GetAllKeysParameters, GetAllKeysResult>(client, loginUir, HttpHelpers.HttpMethod.Post, payload);
        _keys = response.DeserializedResponse.Keys;
        filterData = _keys;

        keyRoles = new List<RoleResult>();
        filterRoleData = keyRoles;

        await GetRoles();
    }

    
    async Task CheckNewKeyName()
    {
        var x = _keys.FirstOrDefault(x => x.Name == createKeyText);
        if (x is null && CheckKeyName() && CheckKeyUid() && CheckSelectedRoles())
        {
            await CreateKey();
        }
    }

    bool CheckSelectedRoles()
    {
        if (filterRoles.Count().Equals(0))
        {
            Snackbar.Add("1 or more roles must be selected.", Severity.Warning);
            return false;
        }
        return true;
    }

    bool CheckKeyName()
    {
        if(createKeyText == string.Empty)
        {
            Snackbar.Add("Key name must not be empty", Severity.Warning);
            return false;
        }
        return true;
    }

    bool CheckKeyUid()
    {
        var cleaned = createKeyUid.Replace(" ", "").Replace("-", "").Replace(":", "");
        if (string.IsNullOrWhiteSpace(cleaned) || cleaned.Length < 2 || !cleaned.All(c => Uri.IsHexDigit(c)))
        {
            Snackbar.Add("Key UID must be a valid hex string from the keycard (e.g. AABBCCDD).", Severity.Warning);
            return false;
        }
        return true;
    }

    async Task<List<Guid>> GetRoleEnumerables()
    {
        List<Guid> results = new List<Guid>();
        foreach (var role in filterRoles)
        {

            var loginUir = new Uri("api/v1/roles/getById", UriKind.Relative);
            var payload = new GetRoleById() { Id = Guid.Parse(role) };
            var client = HttpClientFactory.CreateClient("client");
            var response = await HttpHelpers.CallEndpoint<GetRoleById, GetAllRolesResult>(client, loginUir, HttpHelpers.HttpMethod.Post, payload);
            results.Add(response.DeserializedResponse.Roles.ToList()[0].Id);
        }
        return results;
    }
    
    async Task CreateKey()
    {
        var curRoles = await GetRoleEnumerables();
        var loginUir = new Uri("api/v1/keys/issueNewKey", UriKind.Relative);
        var payload = new IssueNewKeyParameters(){Name = createKeyText, KeyUid = createKeyUid, RoleIds = curRoles};
        var client = HttpClientFactory.CreateClient("client");
        var response = await HttpHelpers.CallEndpoint<IssueNewKeyParameters, IssueNewKeyResult>(client, loginUir, HttpHelpers.HttpMethod.Post, payload);
        createKeyText = string.Empty;
        createKeyUid = string.Empty;
        await LoadPageAsync();
        StateHasChanged();
        Snackbar.Add("Key successfully created.", Severity.Success);
    }
    

    #region IDisposable

    private readonly CancellationTokenSource _cts = new();

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    #endregion

}