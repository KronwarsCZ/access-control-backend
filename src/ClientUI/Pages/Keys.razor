@page "/keys"
@using ApiShared.Dto.Keys
@using ApiShared.Dto.Roles
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@using DemoRegistrationEncryptionUsingRandomNumberAndSalt.Components
@inject ISnackbar Snackbar
@attribute [Authorize]

<PageTitle>Keys</PageTitle>

@if (_keys == null)
{
    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-4 mb-6" Elevation="2" Style="background-color: rgb(255,105,180, 0.15)">
        <MudText Typo="Typo.h6" Class="mb-3">Issue New Key</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="3">
                <MudTextField T="string" Label="Key Name" @bind-Value="@createKeyText" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="3">
                <MudTextField T="string" Label="Key UID (hex, e.g. AABBCCDD)" @bind-Value="@createKeyUid" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="3">
                <MudSelect MultiSelection="true" T="string"
                           MultiSelectionTextFunc="new Func<List<string>, string>(GetMultiSelectionText)"
                           @bind-SelectedValues="@filterRoles"
                           Label="Assign Roles"
                           AdornmentIcon="@Icons.Material.Filled.Security"
                           AnchorOrigin="Origin.BottomCenter"
                           Variant="Variant.Outlined">
                    @foreach (var role in roles)
                    {
                        <MudSelectItem T="string" Value="@role.Id.ToString()">@role.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>
        <MudGrid Spacing="2" Class="mt-2">
            <MudItem xs="3">
                <MudDatePicker Label="Validity Start" @bind-Date="@validityStart" Variant="Variant.Outlined" Clearable="true" Placeholder="Now (default)" />
            </MudItem>
            <MudItem xs="3">
                <MudDatePicker Label="Validity End" @bind-Date="@validityEnd" Variant="Variant.Outlined" Clearable="true" Placeholder="No expiry (default)" />
            </MudItem>
            <MudItem xs="3" Class="d-flex align-end">
                <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Style="background-color: rgb(255,105,180, 0.5)" OnClick="@CheckNewKeyName" Class="mb-1">Create Key</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <CascadingValue Value="@this">
        <KeyTable Data="@_keys" FilterData="@filterData"></KeyTable>
    </CascadingValue>
}

@code {
    [CascadingParameter]
    public Task<AuthenticationState> AuthState { get; set; }

    IEnumerable<KeyResult> filterData { get; set; }
    private IEnumerable<KeyResult> _keys { get; set; }
    string createKeyText = String.Empty;
    string createKeyUid = String.Empty;

    private IEnumerable<RoleResult> roles { get; set; }
    private IEnumerable<string> filterRoles { get; set; }

    DateTime? validityStart = null;
    DateTime? validityEnd = null;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;

        if (user!.Identity!.IsAuthenticated)
            await LoadPageAsync();
        else
            await base.OnInitializedAsync();
    }

    private string GetMultiSelectionText(List<string> selectedValues)
    {
        filterRoles = selectedValues;
        var count = selectedValues.Count;
        return $"Selected role{(count != 1 ? "s" : "")}: {count}";
    }

    public async Task GetRoles()
    {
        var url = new Uri("api/v1/roles/getAllRoles", UriKind.Relative);
        var payload = new GetAllRolesParameters();
        var client = HttpClientFactory.CreateClient("client");
        var response = await HttpHelpers.CallEndpoint<GetAllRolesParameters, GetAllRolesResult>(client, url, HttpHelpers.HttpMethod.Post, payload);
        roles = response.DeserializedResponse.Roles;
    }

    public async Task LoadPageAsync()
    {
        filterData = new List<KeyResult>();
        filterRoles = new List<string>();
        var url = new Uri("api/v1/keys/getAllKeys", UriKind.Relative);
        var payload = new GetAllKeysParameters();
        var client = HttpClientFactory.CreateClient("client");
        var response = await HttpHelpers.CallEndpoint<GetAllKeysParameters, GetAllKeysResult>(client, url, HttpHelpers.HttpMethod.Post, payload);
        _keys = response.DeserializedResponse.Keys;
        filterData = _keys;

        await GetRoles();
    }

    async Task CheckNewKeyName()
    {
        var x = _keys.FirstOrDefault(x => x.Name == createKeyText);
        if (x is null && CheckKeyName() && CheckKeyUid() && CheckSelectedRoles() && CheckValidity())
        {
            await CreateKey();
        }
    }

    bool CheckSelectedRoles()
    {
        if (filterRoles.Count().Equals(0))
        {
            Snackbar.Add("1 or more roles must be selected.", Severity.Warning);
            return false;
        }
        return true;
    }

    bool CheckKeyName()
    {
        if (createKeyText == string.Empty)
        {
            Snackbar.Add("Key name must not be empty", Severity.Warning);
            return false;
        }
        return true;
    }

    bool CheckKeyUid()
    {
        var cleaned = createKeyUid.Replace(" ", "").Replace("-", "").Replace(":", "");
        if (string.IsNullOrWhiteSpace(cleaned) || cleaned.Length < 2 || !cleaned.All(c => Uri.IsHexDigit(c)))
        {
            Snackbar.Add("Key UID must be a valid hex string from the keycard (e.g. AABBCCDD).", Severity.Warning);
            return false;
        }
        return true;
    }

    bool CheckValidity()
    {
        if (validityStart.HasValue && validityEnd.HasValue && validityEnd < validityStart)
        {
            Snackbar.Add("Validity end must be after validity start.", Severity.Warning);
            return false;
        }
        if (validityEnd.HasValue && validityEnd < DateTime.UtcNow)
        {
            Snackbar.Add("Validity end cannot be in the past.", Severity.Warning);
            return false;
        }
        return true;
    }

    async Task<List<Guid>> GetRoleEnumerables()
    {
        List<Guid> results = new List<Guid>();
        foreach (var role in filterRoles)
        {
            var url = new Uri("api/v1/roles/getById", UriKind.Relative);
            var payload = new GetRoleById() { Id = Guid.Parse(role) };
            var client = HttpClientFactory.CreateClient("client");
            var response = await HttpHelpers.CallEndpoint<GetRoleById, GetAllRolesResult>(client, url, HttpHelpers.HttpMethod.Post, payload);
            results.Add(response.DeserializedResponse.Roles.ToList()[0].Id);
        }
        return results;
    }

    async Task CreateKey()
    {
        var curRoles = await GetRoleEnumerables();
        var url = new Uri("api/v1/keys/issueNewKey", UriKind.Relative);
        var payload = new IssueNewKeyParameters()
        {
            Name = createKeyText,
            KeyUid = createKeyUid,
            RoleIds = curRoles,
            ValidityStartUtc = validityStart.HasValue ? DateTime.SpecifyKind(validityStart.Value, DateTimeKind.Utc) : null,
            ValidityEndUtc = validityEnd.HasValue ? DateTime.SpecifyKind(validityEnd.Value, DateTimeKind.Utc) : null
        };
        var client = HttpClientFactory.CreateClient("client");
        await HttpHelpers.CallEndpoint<IssueNewKeyParameters, IssueNewKeyResult>(client, url, HttpHelpers.HttpMethod.Post, payload);
        createKeyText = string.Empty;
        createKeyUid = string.Empty;
        validityStart = null;
        validityEnd = null;
        await LoadPageAsync();
        StateHasChanged();
        Snackbar.Add("Key successfully created.", Severity.Success);
    }

    #region IDisposable

    private readonly CancellationTokenSource _cts = new();

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    #endregion
}
