@page "/roles/{RoleId:guid}"
@using ApiShared.Dto.Roles
@using ApiShared.Dto.Keys
@using ApiShared.Dto.Devices
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@attribute [Authorize]

<PageTitle>Role Detail</PageTitle>

<MudButton StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@GoBack" Variant="Variant.Filled" Color="Color.Secondary" Class="mb-4">Back to Roles</MudButton>

@if (_loading)
{
    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
}
else
{
    <MudText Typo="Typo.h4" Class="mb-6">Role: <strong>@_roleName</strong></MudText>

    <MudText Typo="Typo.h5" Class="mb-3">Assigned Devices</MudText>

    <MudPaper Class="pa-4 mb-2" Elevation="1" Style="background-color: rgb(147,112,219, 0.1)">
        <MudGrid Spacing="2" Class="align-end">
            <MudItem xs="5">
                <MudSelect T="string" Label="Assign a device to this role" @bind-Value="@_selectedDeviceToAdd"
                           AdornmentIcon="@Icons.Material.Filled.Devices" AnchorOrigin="Origin.BottomCenter" Variant="Variant.Outlined">
                    @foreach (var device in _availableDevices)
                    {
                        <MudSelectItem T="string" Value="@device.Id.ToString()">@device.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="3" Class="d-flex align-end">
                <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary"
                           OnClick="@AttachDevice" Disabled="@(string.IsNullOrEmpty(_selectedDeviceToAdd))" Class="mb-1">Assign Device</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudTable Items="@_roleDevices" Hover="true" Elevation="0" Striped="true" HorizontalScrollbar="true"
              Style="background-color: rgb(147,112,219, 0.3)" Class="mb-8">
        <HeaderContent>
            <MudTh><MudTableSortLabel SortBy="new Func<DeviceResult, object>(x => x.Name)">Name</MudTableSortLabel></MudTh>
            <MudTh>Hardware ID</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Created</MudTh>
            <MudTh Style="width:80px">Remove</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Hardware ID">@(context.HardwareId ?? "—")</MudTd>
            <MudTd DataLabel="Type">@context.Type</MudTd>
            <MudTd DataLabel="Created">@context.CreatedUtc</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                               OnClick="@(() => DetachDevice(context.Id, context.Name))" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2">No devices assigned to this role.</MudText>
        </NoRecordsContent>
    </MudTable>

    <MudDivider Class="my-6" />

    <MudText Typo="Typo.h5" Class="mb-3">Assigned Keys</MudText>
    <MudTable Items="@_roleKeys" Hover="true" Elevation="0" Striped="true" HorizontalScrollbar="true"
              Style="background-color: rgb(255,105,180, 0.3)">
        <HeaderContent>
            <MudTh><MudTableSortLabel SortBy="new Func<KeyResult, object>(x => x.Name)">Name</MudTableSortLabel></MudTh>
            <MudTh>Key UID</MudTh>
            <MudTh>Created</MudTh>
            <MudTh>Validity Start</MudTh>
            <MudTh>Validity End</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Key UID"><code>@context.KeyUid</code></MudTd>
            <MudTd DataLabel="Created">@context.CreatedUtc</MudTd>
            <MudTd DataLabel="Validity Start">@context.Validity.StartUtc</MudTd>
            <MudTd DataLabel="Validity End">@(context.Validity.EndUtc?.ToString() ?? "No expiry")</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2">No keys assigned to this role.</MudText>
        </NoRecordsContent>
    </MudTable>
}

<style>
    .mud-table-striped tbody tr:nth-child(even) {
        background-color: rgb(147,112,219, 0.15);
    }
</style>

@code {
    [Parameter]
    public Guid RoleId { get; set; }

    [CascadingParameter]
    public Task<AuthenticationState> AuthState { get; set; }

    private bool _loading = true;
    private string _roleName = string.Empty;
    private List<DeviceResult> _roleDevices = new();
    private List<KeyResult> _roleKeys = new();
    private List<DeviceResult> _allDevices = new();
    private IEnumerable<DeviceResult> _availableDevices => _allDevices.Where(d => !_roleDevices.Any(rd => rd.Id == d.Id));
    private string _selectedDeviceToAdd;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        if (user!.Identity!.IsAuthenticated)
            await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        var client = HttpClientFactory.CreateClient("client");

        var roleTask = HttpHelpers.CallEndpoint<GetRoleById, GetAllRolesResult>(
            client, new Uri("api/v1/roles/getById", UriKind.Relative), HttpHelpers.HttpMethod.Post, new GetRoleById { Id = RoleId });
        var devicesTask = HttpHelpers.CallEndpoint<GetDevicesForRoleParameters, GetAllDevicesResult>(
            client, new Uri("api/v1/roles/getDevicesForRole", UriKind.Relative), HttpHelpers.HttpMethod.Post, new GetDevicesForRoleParameters { RoleId = RoleId });
        var keysTask = HttpHelpers.CallEndpoint<GetKeysForRoleParameters, GetAllKeysResult>(
            client, new Uri("api/v1/roles/getKeysForRole", UriKind.Relative), HttpHelpers.HttpMethod.Post, new GetKeysForRoleParameters { RoleId = RoleId });
        var allDevicesTask = HttpHelpers.CallEndpoint<GetAllDevicesParameters, GetAllDevicesResult>(
            client, new Uri("api/v1/devices/getAllDevices", UriKind.Relative), HttpHelpers.HttpMethod.Post, new GetAllDevicesParameters());

        await Task.WhenAll(roleTask, devicesTask, keysTask, allDevicesTask);

        var role = roleTask.Result.DeserializedResponse.Roles.FirstOrDefault();
        _roleName = role?.Name ?? "Unknown";
        _roleDevices = devicesTask.Result.DeserializedResponse.Devices.ToList();
        _roleKeys = keysTask.Result.DeserializedResponse.Keys.ToList();
        _allDevices = allDevicesTask.Result.DeserializedResponse.Devices.ToList();

        _selectedDeviceToAdd = null;
        _loading = false;
    }

    private async Task AttachDevice()
    {
        if (string.IsNullOrEmpty(_selectedDeviceToAdd)) return;

        var client = HttpClientFactory.CreateClient("client");
        var payload = new AttachRoleToDeviceParameters { DeviceId = Guid.Parse(_selectedDeviceToAdd), RoleId = RoleId };
        var response = await HttpHelpers.CallEndpoint<AttachRoleToDeviceParameters, object>(
            client, new Uri("api/v1/devices/attachRoleToDevice", UriKind.Relative), HttpHelpers.HttpMethod.Post, payload);

        if (response.HttpResponse.IsSuccessStatusCode)
        {
            Snackbar.Add("Device assigned successfully.", Severity.Success);
            await LoadDataAsync();
            StateHasChanged();
        }
        else
        {
            Snackbar.Add("Failed to assign device.", Severity.Error);
        }
    }

    private async Task DetachDevice(Guid deviceId, string deviceName)
    {
        var confirm = await DialogService.ShowMessageBox(
            "Remove Device",
            $"Remove \"{deviceName}\" from this role?",
            yesText: "Remove", cancelText: "Cancel");

        if (confirm != true) return;

        var client = HttpClientFactory.CreateClient("client");
        var payload = new DetachRoleFromDeviceParameters { DeviceId = deviceId, RoleId = RoleId };
        var response = await HttpHelpers.CallEndpoint<DetachRoleFromDeviceParameters, object>(
            client, new Uri("api/v1/devices/detachRoleFromDevice", UriKind.Relative), HttpHelpers.HttpMethod.Post, payload);

        if (response.HttpResponse.IsSuccessStatusCode)
        {
            Snackbar.Add("Device removed from role.", Severity.Success);
            await LoadDataAsync();
            StateHasChanged();
        }
        else
        {
            Snackbar.Add("Failed to remove device.", Severity.Error);
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/Roles");
    }

    #region IDisposable

    private readonly CancellationTokenSource _cts = new();

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    #endregion
}
