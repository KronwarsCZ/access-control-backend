@page "/Roles"
@using ApiShared.Dto.Roles
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@using DemoRegistrationEncryptionUsingRandomNumberAndSalt.Components
@inject ISnackbar Snackbar
@attribute [Authorize]

<PageTitle>Roles</PageTitle>

<MudPaper Class="pa-4 mb-6" Elevation="2" Style="background-color: rgb(147,112,219, 0.15)">
    <MudText Typo="Typo.h6" Class="mb-3">Create New Role</MudText>
    <MudGrid Spacing="2" Class="align-end">
        <MudItem xs="4">
            <MudTextField T="string" Label="Role Name" @bind-Value="@createRoleText" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="4">
            <MudSelect MultiSelection="true" T="string"
                       MultiSelectionTextFunc="new Func<List<string>, string>(GetMultiSelectionText)"
                       @bind-SelectedValues="@filterDevices"
                       Label="Assign to Devices"
                       AdornmentIcon="@Icons.Material.Filled.Devices"
                       AnchorOrigin="Origin.BottomCenter"
                       Variant="Variant.Outlined">
                @foreach (var device in devices)
                {
                    <MudSelectItem T="string" Value="@device.Id.ToString()">@device.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="2" Class="d-flex align-end">
            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Style="background-color: rgb(147,112,219, 0.5)" OnClick="@CheckNewRoleName" Class="mb-1">Create Role</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<CascadingValue Value="@this">
    <RoleTable Data="@roles" FilterData="@filterData"></RoleTable>
</CascadingValue>

@code {
    [CascadingParameter]
    public Task<AuthenticationState> AuthState { get; set; }

    string createRoleText = String.Empty;
    IEnumerable<RoleResult> filterData;
    private IEnumerable<RoleResult> roles;

    private IEnumerable<DeviceResult> devices { get; set; }
    private IEnumerable<string> filterDevices { get; set; }

    Guid createdRoleId = Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;

        if (user!.Identity!.IsAuthenticated)
            await LoadPageAsync();
        else
            await base.OnInitializedAsync();
    }

    private string GetMultiSelectionText(List<string> selectedValues)
    {
        filterDevices = selectedValues;
        var count = selectedValues.Count;
        return $"Selected device{(count != 1 ? "s" : "")}: {count}";
    }

    public async Task GetRoles()
    {
        var url = new Uri("api/v1/roles/getAllRoles", UriKind.Relative);
        var payload = new GetAllRolesParameters();
        var client = HttpClientFactory.CreateClient("client");
        var response = await HttpHelpers.CallEndpoint<GetAllRolesParameters, GetAllRolesResult>(client, url, HttpHelpers.HttpMethod.Post, payload);
        roles = response.DeserializedResponse.Roles;
        filterData = roles;
    }

    public async Task GetDevices()
    {
        var url = new Uri("api/v1/devices/getAllDevices", UriKind.Relative);
        var payload = new GetAllDevicesParameters();
        var client = HttpClientFactory.CreateClient("client");
        var response = await HttpHelpers.CallEndpoint<GetAllDevicesParameters, GetAllDevicesResult>(client, url, HttpHelpers.HttpMethod.Post, payload);
        devices = response.DeserializedResponse.Devices;
    }

    async Task AddRoleToDevices()
    {
        if (createdRoleId == Guid.Empty) return;
        foreach (var device in filterDevices)
        {
            var url = new Uri("api/v1/devices/attachRoleToDevice", UriKind.Relative);
            var payload = new AttachRoleToDeviceParameters() { DeviceId = Guid.Parse(device), RoleId = createdRoleId };
            var client = HttpClientFactory.CreateClient("client");
            await HttpHelpers.CallEndpoint<AttachRoleToDeviceParameters, AttachRoleToDeviceResult>(client, url, HttpHelpers.HttpMethod.Post, payload);
        }
        createdRoleId = Guid.Empty;
    }

    public async Task RefreshState()
    {
        await GetRoles();
        StateHasChanged();
    }

    async Task CheckNewRoleName()
    {
        var x = roles.FirstOrDefault(x => x.Name == createRoleText);
        if (x is null && CheckRoleName() && CheckSelectedDevices())
        {
            await CreateRole();
        }
    }

    bool CheckSelectedDevices()
    {
        if (filterDevices.Count().Equals(0))
        {
            Snackbar.Add("1 or more devices must be selected.", Severity.Warning);
            return false;
        }
        return true;
    }

    bool CheckRoleName()
    {
        if (createRoleText == string.Empty)
        {
            Snackbar.Add("Role name must not be empty", Severity.Warning);
            return false;
        }
        return true;
    }

    public async Task LoadPageAsync()
    {
        filterDevices = new List<string>();
        devices = new List<DeviceResult>();
        await GetRoles();
        await GetDevices();
    }

    async Task CreateRole()
    {
        var url = new Uri("api/v1/roles/addNewRole", UriKind.Relative);
        var payload = new RoleAddParameters() { Name = createRoleText };
        var client = HttpClientFactory.CreateClient("client");
        var response = await HttpHelpers.CallEndpoint<RoleAddParameters, RoleAddResult>(client, url, HttpHelpers.HttpMethod.Post, payload);
        createdRoleId = response.DeserializedResponse.RoleId;
        await GetRoles();
        await AddRoleToDevices();
        createRoleText = String.Empty;
        await LoadPageAsync();
        StateHasChanged();
        Snackbar.Add("Role successfully created.", Severity.Success);
    }

    #region IDisposable

    private readonly CancellationTokenSource _cts = new();

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    #endregion
}
