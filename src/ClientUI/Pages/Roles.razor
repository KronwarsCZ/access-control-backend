@page "/Roles"
@using ApiShared.Dto.Roles
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@using AccessControl.ClientUI.Components
@inject IDialogService DialogService
@attribute [Authorize]

<PageTitle>Roles</PageTitle>

<MudPaper Class="pa-4 mb-6 d-flex align-center" Elevation="2" Style="background-color: rgb(147,112,219, 0.15)">
    <MudText Typo="Typo.h6">Roles</MudText>
    <MudSpacer />
    <MudButton StartIcon="@Icons.Material.Filled.Add"
               Variant="Variant.Filled"
               Style="background-color: rgb(147,112,219, 0.5)"
               OnClick="OpenCreateRoleDialog">
        Create Role
    </MudButton>
</MudPaper>

<CascadingValue Value="@this">
    <RoleTable Data="@roles" FilterData="@filterData"></RoleTable>
</CascadingValue>

@code {
    [CascadingParameter]
    public Task<AuthenticationState> AuthState { get; set; }

    IEnumerable<RoleResult> filterData;
    private IEnumerable<RoleResult> roles;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;

        if (user!.Identity!.IsAuthenticated)
            await LoadPageAsync();
        else
            await base.OnInitializedAsync();
    }

    public async Task GetRoles()
    {
        var url = new Uri("api/v1/roles/getAllRoles", UriKind.Relative);
        var payload = new GetAllRolesParameters();
        var client = HttpClientFactory.CreateClient("client");
        var response = await HttpHelpers.CallEndpoint<GetAllRolesParameters, GetAllRolesResult>(client, url, HttpHelpers.HttpMethod.Post, payload);
        roles = response.DeserializedResponse.Roles;
        filterData = roles;
    }

    public async Task RefreshState()
    {
        await GetRoles();
        StateHasChanged();
    }

    public async Task LoadPageAsync()
    {
        await GetRoles();
    }

    async Task OpenCreateRoleDialog()
    {
        var parameters = new DialogParameters<CreateRoleDialog>
        {
            { x => x.ExistingRoles, roles ?? Enumerable.Empty<RoleResult>() }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<CreateRoleDialog>("Create Role", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await RefreshState();
        }
    }

    #region IDisposable

    private readonly CancellationTokenSource _cts = new();

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    #endregion
}
