@page "/devices"

@using ApiShared.Dto.Roles
@implements IDisposable
@inject ISnackbar Snackbar
@inject IHttpClientFactory HttpClientFactory
@inject IDialogService DialogService
@using DemoRegistrationEncryptionUsingRandomNumberAndSalt.Components
@attribute [Authorize]

<PageTitle>Devices</PageTitle>

@if (devices == null)
{
    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
}
else if (rolesForDeviceVisible)
{
    <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@ShowRoles" Variant="Variant.Filled" Color="Color.Secondary" Class="mb-4">Back</MudButton>

    <MudText Typo="Typo.h5" Class="mb-4">Roles assigned to device: <strong>@selectedDeviceName</strong></MudText>

    <MudTable Items="@roleResults" Hover="true" SortLabel="Sort By" Elevation="0" Style="background-color: rgb(147,112,219, 0.3)" Striped="true" HorizontalScrollbar="true">
        <ToolBarContent>
            <MudSpacer/>
            <MudTextField Immediate="true" @bind-Value="@roleSearchString" TextChanged="@FilterRoles" Placeholder="Search roles..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortBy="new Func<RoleResult, object>(x => x.Name)">Name</MudTableSortLabel></MudTh>
            <MudTh>ID</MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<RoleResult, object>(x => x.CreatedUtc)">Created</MudTableSortLabel></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="ID">@context.Id.ToString()</MudTd>
            <MudTd DataLabel="Created">@context.CreatedUtc</MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new [] { 50, 100 }" />
        </PagerContent>
    </MudTable>
}
else
{
    <MudGrid Class="mb-4" Spacing="2">
        <MudItem xs="4">
            <MudTextField T="string" Label="Filter by name" @bind-Value="@filterText" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" />
        </MudItem>
        <MudItem xs="2" Class="d-flex align-end">
            <MudButton StartIcon="@Icons.Material.Filled.FilterAlt" Variant="Variant.Filled" Style="background-color: rgb(147,112,219, 0.5)" OnClick="@ApplyFilter">Filter</MudButton>
        </MudItem>
        <MudItem xs="2" Class="d-flex align-end">
            @if (!string.IsNullOrEmpty(filterText))
            {
                <MudButton StartIcon="@Icons.Material.Filled.Clear" Variant="Variant.Outlined" Color="Color.Default" OnClick="@ClearFilter">Clear</MudButton>
            }
        </MudItem>
    </MudGrid>

    <MudTable Items="filteredDevices" Hover="true" SortLabel="Sort By" Elevation="0" Style="background-color: rgb(147,112,219, 0.3)" Striped="true" HorizontalScrollbar="true">
        <HeaderContent>
            <MudTh><MudTableSortLabel SortBy="new Func<DeviceResult, object>(x => x.Name)">Name</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<DeviceResult, object>(x => x.HardwareId ?? string.Empty)">Hardware ID</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<DeviceResult, object>(x => x.CreatedUtc)">Created</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<DeviceResult, object>(x => x.UpdatedUtc)">Last Updated</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<DeviceResult, object>(x => x.Type)">Type</MudTableSortLabel></MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Hardware ID">@(context.HardwareId ?? "—")</MudTd>
            <MudTd DataLabel="Created">@context.CreatedUtc</MudTd>
            <MudTd DataLabel="Last Updated">@context.UpdatedUtc</MudTd>
            <MudTd DataLabel="Type">@context.Type</MudTd>
            <MudTd DataLabel="Actions">
                <MudFab @onclick="@(() => ShowRolesForDevice(@context.Id, @context.Name))" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Settings" Size="Size.Small" IconSize="Size.Small" Class="mr-1" />
                <MudFab @onclick="@(() => OpenRenameDialog(@context.Id, @context.Name))" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Edit" Size="Size.Small" IconSize="Size.Small" Class="mr-1" />
                <MudFab @onclick="@(() => DeleteDevice(@context.Id, @context.Name))" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" Size="Size.Small" IconSize="Size.Small" />
            </MudTd>
        </RowTemplate>

        <PagerContent>
            <MudTablePager PageSizeOptions="new [] { 50, 100 }"/>
        </PagerContent>
    </MudTable>
}

<style>
    .mud-table-striped tbody tr:nth-child(even) {
        background-color: rgb(255,105,180, 0.3);
    }
</style>

@code {
    [CascadingParameter]
    public Task<AuthenticationState> AuthState { get; set; }

    string filterText = string.Empty;
    private IEnumerable<DeviceResult> devices;
    private IEnumerable<DeviceResult> filteredDevices;

    bool rolesForDeviceVisible = false;
    string selectedDeviceName = string.Empty;
    IEnumerable<RoleResult> roleResults { get; set; }
    IEnumerable<RoleResult> allRolesForDevice { get; set; }
    string roleSearchString = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;

        if (user!.Identity!.IsAuthenticated)
            await LoadPageAsync();
        else
            await base.OnInitializedAsync();
    }

    public async Task ShowRolesForDevice(Guid id, string name)
    {
        var url = new Uri("api/v1/devices/getAllRolesForDevice", UriKind.Relative);
        var payload = new GetAllRolesForDeviceParameters() { DeviceId = id };
        var client = HttpClientFactory.CreateClient("client");
        var response = await HttpHelpers.CallEndpoint<GetAllRolesForDeviceParameters, GetAllRolesForDeviceResult>(client, url, HttpHelpers.HttpMethod.Post, payload);
        allRolesForDevice = response.DeserializedResponse.Roles;
        roleResults = allRolesForDevice;
        selectedDeviceName = name;
        roleSearchString = string.Empty;
        rolesForDeviceVisible = true;
        StateHasChanged();
    }

    void FilterRoles()
    {
        if (string.IsNullOrWhiteSpace(roleSearchString))
            roleResults = allRolesForDevice;
        else
            roleResults = allRolesForDevice.Where(r => r.Name.Contains(roleSearchString, StringComparison.OrdinalIgnoreCase));
        StateHasChanged();
    }

    public void ShowRoles()
    {
        rolesForDeviceVisible = false;
        StateHasChanged();
    }

    void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(filterText))
            filteredDevices = devices;
        else
            filteredDevices = devices.Where(d => d.Name.Contains(filterText, StringComparison.OrdinalIgnoreCase));
        StateHasChanged();
    }

    void ClearFilter()
    {
        filterText = string.Empty;
        filteredDevices = devices;
        StateHasChanged();
    }

    async Task DeleteDevice(Guid deviceId, string deviceName)
    {
        var confirm = await DialogService.ShowMessageBox(
            "Delete Device",
            $"Are you sure you want to delete \"{deviceName}\"? This cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");

        if (confirm != true) return;

        var url = new Uri("api/v1/devices/deleteDevice", UriKind.Relative);
        var payload = new DeviceDeleteParameters() { DeviceId = deviceId };
        var client = HttpClientFactory.CreateClient("client");
        await HttpHelpers.CallEndpoint<DeviceDeleteParameters, DeviceDeleteResult>(client, url, HttpHelpers.HttpMethod.Post, payload);
        Snackbar.Add("Device successfully deleted.", Severity.Success);
        await LoadPageAsync();
        StateHasChanged();
    }

    async Task OpenRenameDialog(Guid deviceId, string currentName)
    {
        var parameters = new DialogParameters<RenameDeviceDialog>
        {
            { x => x.DeviceId, deviceId },
            { x => x.CurrentName, currentName }
        };
        var dialog = await DialogService.ShowAsync<RenameDeviceDialog>("Rename Device", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadPageAsync();
            StateHasChanged();
        }
    }

    private async Task LoadPageAsync()
    {
        var url = new Uri("api/v1/devices/getAllDevices", UriKind.Relative);
        var payload = new GetAllDevicesParameters();
        var client = HttpClientFactory.CreateClient("client");
        var response = await HttpHelpers.CallEndpoint<GetAllDevicesParameters, GetAllDevicesResult>(client, url, HttpHelpers.HttpMethod.Post, payload);
        devices = response.DeserializedResponse.Devices;
        filteredDevices = devices;
    }

    #region IDisposable

    private readonly CancellationTokenSource _cts = new();

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    #endregion
}
