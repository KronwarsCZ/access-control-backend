@page "/devices"

@using ApiShared.Dto.Roles
@implements IDisposable
@inject ISnackbar Snackbar
@inject IHttpClientFactory HttpClientFactory
@using DemoRegistrationEncryptionUsingRandomNumberAndSalt.Components
@attribute [Authorize]

<PageTitle>Devices</PageTitle>

@if (devices == null)
{
    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
}
else if (rolesForDeviceVisible)
{
    <MudGrid>
        <MudItem xs="8">
        <RolesForKeyTable Data="@roleResults" FilterData="@filterRoleResults"></RolesForKeyTable>
    </MudItem>
    <MudButton OnClick="@ShowRoles" Variant="Variant.Filled" Color="Color.Secondary">Back</MudButton>
    </MudGrid>
}
else
{
    <MudGrid>
        <MudItem xs="6">
            <MudTextField T="string" Label="Device Name" @bind-Value="@createDeviceText"></MudTextField>
        </MudItem>
        <MudItem xs="6" Class="pa-8">
            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Style="background-color: rgb(147,112,219, 0.3)" OnClick="@CheckNewDeviceName">Create Device</MudButton>
        </MudItem>
    </MudGrid>

    <MudTable Items="devices" Hover="true" SortLabel="Sort By" Elevation="0" Style="background-color: rgb(147,112,219, 0.3)" Striped="true" HorizontalScrollbar="true">
        <HeaderContent>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<DeviceResult, object>(x => x.Name)">Name</MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<DeviceResult, object>(x => x.Id)">Identifier</MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<DeviceResult, object>(x => x.CreatedUtc)">Created</MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<DeviceResult, object>(x => x.UpdatedUtc)">Last Updated</MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<DeviceResult, object>(x => x.Type)">Type</MudTableSortLabel>
            </MudTh>
            <MudTh>Detail</MudTh>
            
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Identifier">@context.Id.ToString()</MudTd>
            <MudTd DataLabel="Created">@context.CreatedUtc</MudTd>
            <MudTd DataLabel="Last Updated">@context.UpdatedUtc</MudTd>
            <MudTd DataLabel="Type">@context.Type</MudTd>
            <MudTd DataLabel="Detail"> <MudFab @onclick="@(() => ShowRolesForDevice(@context.Id))" Color="Color.Primary" Icon="@Icons.Material.Filled.RemoveRedEye" Size="Size.Small" IconSize="Size.Small"/></MudTd>
        </RowTemplate>

        <PagerContent>
            <MudTablePager PageSizeOptions="new [] { 50, 100 }"/>
        </PagerContent>
    </MudTable>
    <style>
    .mud-table-striped tbody tr:nth-child(even) {
        background-color: rgb(255,105,180, 0.3);
    }
</style>
}



@code {
    
    
    [CascadingParameter]
    public Task<AuthenticationState> AuthState { get; set; }

    string createDeviceText = String.Empty;
    IEnumerable<DeviceResult> filterData;
    private IEnumerable<DeviceResult> devices;

    bool rolesForDeviceVisible = false;
    IEnumerable<RoleResult> roleResults { get; set; }
    IEnumerable<RoleResult> filterRoleResults { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;

        if (user!.Identity!.IsAuthenticated)
            await LoadPageAsync();
        else
            await base.OnInitializedAsync();
    }
    
    public async Task ShowRolesForDevice(Guid id)
    {
        var loginUir = new Uri("api/v1/devices/getAllRolesForDevice", UriKind.Relative);
        var payload = new GetAllRolesForDeviceParameters(){DeviceId = id};
        var client = HttpClientFactory.CreateClient("client");
        var response = await HttpHelpers.CallEndpoint<GetAllRolesForDeviceParameters, GetAllRolesForDeviceResult>(client, loginUir, HttpHelpers.HttpMethod.Post, payload);
        roleResults = response.DeserializedResponse.Roles;
        filterRoleResults = roleResults;
        rolesForDeviceVisible = true;
        StateHasChanged();
    }
    
    async Task CheckNewDeviceName()
    {
        if (createDeviceText == string.Empty)
        {
            Snackbar.Add("Device name must not be empty.", Severity.Warning);
            return;
        }
        var x = devices.FirstOrDefault(x => x.Name == createDeviceText);
        if (x is null)
        {
            await CreateDevice();
        }
    }
    
    public void ShowRoles()
    {
        rolesForDeviceVisible = false;
        StateHasChanged();
    }

    async Task CreateDevice()
    {
        var loginUir = new Uri("api/v1/devices/registerNewDevice", UriKind.Relative);
        var payload = new DeviceAddParameters(){Name = createDeviceText};
        var client = HttpClientFactory.CreateClient("client");
        var response = await HttpHelpers.CallEndpoint<DeviceAddParameters, DeviceAddResult>(client, loginUir, HttpHelpers.HttpMethod.Post, payload);
        await CreateRole();
        createDeviceText = string.Empty;
        await LoadPageAsync();
        StateHasChanged();
        Snackbar.Add("Device successfully created.", Severity.Success);
    }

    async Task CreateRole()
    {
        var loginUir = new Uri("api/v1/roles/addNewRole", UriKind.Relative);
        var payload = new RoleAddParameters(){Name = createDeviceText};
        var client = HttpClientFactory.CreateClient("client");
        var response = await HttpHelpers.CallEndpoint<RoleAddParameters, RoleAddResult>(client, loginUir, HttpHelpers.HttpMethod.Post, payload);
    }

    private async Task LoadPageAsync()
    {
        var url = new Uri("api/v1/devices/getAllDevices", UriKind.Relative);
        var payload = new GetAllDevicesParameters();
        var client = HttpClientFactory.CreateClient("client");
        var response = await HttpHelpers.CallEndpoint<GetAllDevicesParameters, GetAllDevicesResult>(client, url, HttpHelpers.HttpMethod.Post, payload);
        devices = response.DeserializedResponse.Devices;
        filterRoleResults = roleResults;
    }




    #region IDisposable

    private readonly CancellationTokenSource _cts = new();

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    #endregion

}