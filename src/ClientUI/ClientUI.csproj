<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS8618</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AccessControl.ClientUI</RootNamespace>
    <AssemblyName>AccessControl.ClientUI</AssemblyName>
    <Version>0.0.1</Version>
    <SourceRevisionId>$(SourceRevisionId)</SourceRevisionId>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <Target Name="SetSourceRevisionId" BeforeTargets="InitializeSourceControlInformation">
    <Exec Command="git describe --always --dirty" ConsoleToMSBuild="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="SourceRevisionId" />
    </Exec>
  </Target>

  <ItemGroup>
	  <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
	  <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="8.0.16" />
	  <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.16" />
	  <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.16" PrivateAssets="all" />
	  <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.5" />
	  <PackageReference Include="MudBlazor" Version="8.7.0" />
	  <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApiShared\ApiShared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <_ContentIncludedByDefault Remove="wwwroot\sample-data\weather.json" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Pages\Roles\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="Pages\Roles\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Pages\Roles\**" />
    <Content Remove="Pages\Profile.razor" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Pages\Roles\**" />
  </ItemGroup>
</Project>
