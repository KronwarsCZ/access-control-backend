@using Pages
@using ApiShared.Dto.Keys
@inject IHttpClientFactory HttpClientFactory
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@attribute [Authorize]


<MudTable Elevation="0" Items="@FilterData" SortLabel="Sort by" Hover="true" LoadingProgressColor="Color.Default" Outlined="true" Bordered="true" Class="border-solid border-2 mud-border-black pa-4" Striped="true" HorizontalScrollbar="true" Style="background-color: rgb(255,105,180, 0.3)">

    <ToolBarContent>
        <MudSpacer/>
        <MudTextField Immediate="true" TextChanged="@NewData" @bind-Value="@searchString" Placeholder="Search for keys..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
    </ToolBarContent>

    <ColGroup>
        <col />
        <col style="width: 160px"/>
    </ColGroup>
    <HeaderContent>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<KeyResult, object>(x => x.Name)"> Name</MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<KeyResult, object>(x => x.KeyUid)"> Key UID</MudTableSortLabel>
        </MudTh>
        <MudTh>Created</MudTh>
        <MudTh>Validity Start</MudTh>
        <MudTh>Validity End</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Key UID"><code>@context.KeyUid</code></MudTd>
        <MudTd DataLabel="Created">@context.CreatedUtc.ToString()</MudTd>
        <MudTd DataLabel="Validity Start">@context.Validity.StartUtc.ToString()</MudTd>
        <MudTd DataLabel="Validity End">@(context.Validity.EndUtc?.ToString() ?? "No expiry")</MudTd>
        <MudTd DataLabel="Actions">
            <MudFab @onclick="@(() => NavigateToKeyDetail(@context.Id))" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Settings" Size="Size.Small" IconSize="Size.Small" Class="mr-1"/>
            <MudFab @onclick="@(() => OpenRenameDialog(@context.Id, @context.Name))" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Edit" Size="Size.Small" IconSize="Size.Small" Class="mr-1"/>
            <MudFab @onclick="@(() => Delete(@context.Id))" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" Size="Size.Small" IconSize="Size.Small"/>
        </MudTd>
    </RowTemplate>
</MudTable>
<style>
    .mud-table-striped tbody tr:nth-child(even) {
        background-color: rgb(147,112,219, 0.3);
    }
</style>

@code {

    [CascadingParameter]
    public Keys Parent { get; set; }

    [Parameter] public IEnumerable<KeyResult> Data { get; set; }

    [Parameter] public IEnumerable<KeyResult> FilterData { get; set; }


    string searchString = string.Empty;

    void NavigateToKeyDetail(Guid keyId)
    {
        NavigationManager.NavigateTo($"/keys/{keyId}");
    }

    private async Task Delete(Guid id)
    {
        var loginUir = new Uri("api/v1/keys/deleteKey", UriKind.Relative);
        var payload = new KeyDeleteParameters() { KeyId = id };
        var client = HttpClientFactory.CreateClient("client");
        var response = await HttpHelpers.CallEndpoint<KeyDeleteParameters, KeyDeleteResult>(client, loginUir, HttpHelpers.HttpMethod.Post, payload);
        NavigationManager.NavigateTo("/Keys", forceLoad: true);
        Snackbar.Add("Key successfully deleted.", Severity.Success);
    }

    async Task OpenRenameDialog(Guid keyId, string currentName)
    {
        var parameters = new DialogParameters<RenameKeyDialog>
        {
            { x => x.KeyId, keyId },
            { x => x.CurrentName, currentName }
        };
        var dialog = await DialogService.ShowAsync<RenameKeyDialog>("Rename Key", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await Parent.RefreshState();
        }
    }

    void NewData()
    {
        var term = searchString.ToLower();
        FilterData = Data.Where(x => x.Name.ToLower().Contains(term) || (x.KeyUid?.ToLower().Contains(term) ?? false)).ToList();
        StateHasChanged();
    }

    #region IDisposable

    private readonly CancellationTokenSource _cts = new();
    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    #endregion
}
