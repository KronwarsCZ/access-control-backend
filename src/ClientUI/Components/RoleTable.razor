@using Pages
@using ApiShared.Dto.Roles
@inject IHttpClientFactory HttpClientFactory
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@attribute [Authorize]

<MudTable Elevation="0" Items="@FilterData" SortLabel="Sort by" Hover="true" LoadingProgressColor="Color.Default" Outlined="true" Bordered="true" Class="border-solid border-2 mud-border-black pa-4" Striped="true" HorizontalScrollbar="true" Style="background-color: rgb(147,112,219, 0.3)">
    
    <ToolBarContent>
        <MudSpacer/>
        <MudTextField Immediate="true" TextChanged="@NewData" @bind-Value="@searchString" Placeholder="Search for roles..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
    </ToolBarContent>
    
    <ColGroup>
        <col />
        <col style="width: 160px"/>
    </ColGroup>
    <HeaderContent>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<RoleResult, object>(x => x.Name)"> Name</MudTableSortLabel>
        </MudTh>
        <MudTh>ID</MudTh>
        <MudTh>Created</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Role Name">@context.Name</MudTd>
        <MudTd DataLabel="ID">@context.Id.ToString()</MudTd>
        <MudTd DataLabel="Created">@context.CreatedUtc.ToString()</MudTd>
        <MudTd DataLabel="Actions">
            <MudFab @onclick="@(() => OpenRenameDialog(@context.Id, @context.Name))" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Edit" Size="Size.Small" IconSize="Size.Small" Class="mr-1" />
            <MudFab @onclick="@(() => Delete(@context.Id))" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Delete" Size="Size.Small" IconSize="Size.Small"/>
        </MudTd>
    </RowTemplate>
</MudTable>
<style>
    .mud-table-striped tbody tr:nth-child(even) {
        background-color: rgb(255,105,180, 0.3);
    }
</style>

@code {
    
    [CascadingParameter]
    public Roles Parent { get; set; }
    
    [Parameter] public IEnumerable<RoleResult> Data { get; set; }

    [Parameter] public IEnumerable<RoleResult> FilterData { get; set; }
    
    
    string searchString = string.Empty;

    public async Task Delete(Guid id)
    {
        var loginUir = new Uri("api/v1/roles/deleteRole", UriKind.Relative);
        var payload = new RoleDeleteParameters(){RoleId = id};
        var client = HttpClientFactory.CreateClient("client");
        var response = await HttpHelpers.CallEndpoint<RoleDeleteParameters, RoleDeleteResult>(client, loginUir, HttpHelpers.HttpMethod.Post, payload);
        NavigationManager.NavigateTo("/Roles", forceLoad:true);
        Snackbar.Add("Role successfully deleted.", Severity.Success);
    }

    async Task OpenRenameDialog(Guid roleId, string currentName)
    {
        var parameters = new DialogParameters<RenameRoleDialog>
        {
            { x => x.RoleId, roleId },
            { x => x.CurrentName, currentName }
        };
        var dialog = await DialogService.ShowAsync<RenameRoleDialog>("Rename Role", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await Parent.RefreshState();
        }
    }
    
    void NewData()
    {
        FilterData = Data.Where(x => x.Name.ToLower().Contains(searchString.ToLower())).ToList();
        StateHasChanged();
    }
    
    #region IDisposable

    private readonly CancellationTokenSource _cts = new();
    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    #endregion
}
