@inject IJSRuntime JSRuntime


<PageTitle>Not found</PageTitle>

<LayoutView Layout="@typeof(EmptyLayout)">
    <MudContainer MaxWidth="MaxWidth.Medium" Class="d-flex align-center" Style="height: 60vh;">
        <MudPaper Elevation="35" Class="pa-8" Style="width: 600px;">
            <MudText Style="text-align: center;padding-top: 15vh; font-size: 2em">Whoops, looks like there is nothing here</MudText>
            <MudButton OnClick="GoBack" DisableElevation="true" Color="Color.Primary" Variant="Variant.Filled">Go back</MudButton>
        </MudPaper>
    </MudContainer>            
</LayoutView>

@code
{
    private async Task GoBack()
    {
        await JSRuntime.InvokeVoidAsync("history.back");
    }
}


