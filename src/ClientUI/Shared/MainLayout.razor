@inherits LayoutComponentBase
@inject NavigationManager navigationManager;
@inject IHttpClientFactory HttpClientFactory;
@inject ILocalStorageService localStorageService;

<MudThemeProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>
<MudPopoverProvider/>


<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@DrawerToggle"/>
        <MudLink Href="/" Class="pa-4 mud-theme-primary" Underline="Underline.None" Typo="Typo.h5">Access Control App</MudLink >
        <MudSpacer/>
        <MudTooltip Text="@_appVersion">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Inherit">@_shortVersion</MudChip>
        </MudTooltip>

        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <ActivatorContent>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Person">
                    @_userEmail
                </MudButton>
            </ActivatorContent>
            <ChildContent>
                <div class="pa-4" style="min-width: 220px;">
                    <MudText Typo="Typo.body1" Class="mb-0">Hello, <b>@_userEmail</b></MudText>
                </div>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Filled.Lock" Href="/change-password">Change Password</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="@Logout">Logout</MudMenuItem>
            </ChildContent>
        </MudMenu>

    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <AccessControlNavMenu></AccessControlNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-16 pt-16">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>


@code {

    bool _drawerOpen = false;
    string _userEmail = "";
    string _appVersion = "";
    string _shortVersion = "";

    static string GetAppVersion()
    {
        var asm = System.Reflection.Assembly.GetExecutingAssembly();
        var infoVersion = System.Reflection.CustomAttributeExtensions.GetCustomAttribute<System.Reflection.AssemblyInformationalVersionAttribute>(asm)?.InformationalVersion;
        return infoVersion ?? asm.GetName().Version?.ToString() ?? "?";
    }

    [CascadingParameter]
    public Task<AuthenticationState> AuthState { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _appVersion = GetAppVersion();
        // Show just the git hash part (after '+') or fall back to full version
        var plusIndex = _appVersion.IndexOf('+');
        _shortVersion = plusIndex >= 0 ? _appVersion[(plusIndex + 1)..] : _appVersion;

        var user = (await AuthState).User;
        if (user.Identity?.IsAuthenticated == true)
        {
            _userEmail = user.FindFirst("email")?.Value
                         ?? user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                         ?? "";
        }
    }

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task Logout()
    {
        await localStorageService.RemoveItemAsync(AuthSharedConfiguration.AccessTokenKey);

        var loginUir = new Uri("api/v1/logout", UriKind.Relative);

        var client = HttpClientFactory.CreateClient("client");
        try
        {
            await HttpHelpers.CallEndpoint<Task, LoginResult>(client, loginUir, HttpHelpers.HttpMethod.Post);
        }
        catch (Exception)
        {
        }
        navigationManager.NavigateTo("/login", true);
    }
}