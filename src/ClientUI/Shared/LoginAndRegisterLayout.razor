    </MudPaper>
    <MudImage Style="width: 750px" Src="static/login-graphic.svg"></MudImage>
</MudContainer>
<MudText Style="text-align: center;padding-top: 4em; font-size: 1em">Made with ❤️ in Prague</MudText>
<MudText Style="text-align: center;padding-top: 1em; font-size: 1em">Petr Budai</MudText>
