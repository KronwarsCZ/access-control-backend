@inherits LayoutComponentBase

<MudThemeProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudText Style="text-align: center;padding-top: 15vh; font-size: 4em">Welcome to AccessControl app 🔑</MudText>
<MudContainer MaxWidth="MaxWidth.Large" Class="d-flex align-center" Style="height: 60vh;">
    <MudPaper Elevation="35" Class="pa-8" Style="width: 1200px;">
        @Body
