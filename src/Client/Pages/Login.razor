@page "/login"

@inject NavigationManager NavigationManager
@inject HttpClient HttpClient
@using System.ComponentModel.DataAnnotations
@using ApiShared.Dto
@using ApiShared.Dto.Auth
@using Blazored.LocalStorage

@inject ILocalStorageService _localStorageService

@inject ISnackbar Snackbar


<PageTitle>Login</PageTitle>


<EditForm Model="@model" OnValidSubmit="Authenticate">
    <DataAnnotationsValidator/>
    <MudGrid>
        <MudItem xs="12" sm="7">
            <MudCard>
                <MudCardContent>
                    <MudTextField Label="Email" Class="mt-3"@bind-Value="model.Email" For="@(() => model.Email)"/>
                    <MudTextField Label="Password" HelperText="Enter your password" Class="mt-3"@bind-Value="model.Password" For="@(() => model.Password)" InputType="InputType.Password"/>
                </MudCardContent>
                <MudCardActions>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto">Login</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</EditForm>

<MudLink Href="/register">
    <MudText >Dont have an account yet?</MudText>
</MudLink>

@code {

    LoginAccountFormModel model = new();

    public class LoginAccountFormModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; }

        [Required]
        [StringLength(64, MinimumLength = 8)]
        public string Password { get; set; }
    }

    private async Task Authenticate()
    {
        var loginUrl = new Uri("api/v1/login", UriKind.Relative);
        var payload = new LoginParameters
        {
            Email = model.Email,
            Password = model.Password,
        };
        var apiResponse = await HttpHelper.CallEndpoint<LoginParameters,LoginResult>(HttpClient, loginUrl, HttpHelper.HttpMethod.Post, payload);
        if (apiResponse.HttpResponse.IsSuccessStatusCode)
        {
            await _localStorageService.SetItemAsync("AccessToken", apiResponse.DeserializedResponse.Token);
            NavigationManager.NavigateTo("/");
        }
        else
        {
            DisplayEmailOrPasswordIncorrect();
        }
    }

    private void DisplayEmailOrPasswordIncorrect()
    {
        Snackbar.Add("Email or password is incorrect.", Severity.Error);
    }

}