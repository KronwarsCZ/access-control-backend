@page "/devices"
@using Microsoft.AspNetCore.Authorization
@using ApiShared.Dto.Devices
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory

@attribute [Authorize]

<PageTitle>Devices</PageTitle>

@if (_devices == null)
{
    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
}
else
{
    <MudTable Items="_devices" Hover="true" SortLabel="Sort By" Elevation="0">
        <HeaderContent>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<DeviceResult, object>(x => x.Id)">Identifier</MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<DeviceResult, object>(x => x.Name)">Name</MudTableSortLabel>
            </MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Identifier">@context.Id</MudTd>
            <MudTd DataLabel="Name">@context.Name</MudTd>
        </RowTemplate>

        <PagerContent>
            <MudTablePager PageSizeOptions="new [] { 50, 100 }"/>
        </PagerContent>
    </MudTable>
}


@code {
    private IEnumerable<DeviceResult> _devices;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var client = HttpClientFactory.CreateClient("client");
        var getDevicesUri = new Uri("api/v1/devices/getAllDevices", UriKind.Relative);
        var payload = new GetAllDevicesParameters
        {
            OwnerId = Guid.Parse("A094B604-0CBC-44CF-93C4-B07B012573DE")
        };
        var response = await HttpHelper.CallEndpoint<GetAllDevicesParameters, GetAllDevicesResult>(client, getDevicesUri, HttpHelper.HttpMethod.Post, payload);
        
        
    }


    #region IDisposable

    private readonly CancellationTokenSource _cts = new();

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    #endregion

}