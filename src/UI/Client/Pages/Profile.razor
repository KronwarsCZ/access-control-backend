@page "/Profile"
@using Core.Entities.Areas
@using Core.Entities.Buildings
@using Core.Entities.Owners
@using MudBlazor
<PageTitle>Profile</PageTitle>

<h1>Profile</h1>
<MudGrid>
    <MudItem xs="4">
        <MudPaper Width="300px">
            <MudList Clickable="true" @bind-SelectedItem="selectedItemArea" @bind-SelectedValue="selectedValueArea">
                <MudListSubheader>
                    Current Area
                </MudListSubheader>
                @{
                    foreach (var item in listArea)
                    {
                        <MudListItem Text="@item.Name" Value="@curValueArea" OnClick="GetBuildings"></MudListItem>
                        if (curValueArea >= listArea.Count()-1)
                        {
                            curValueArea = 0;
                        }
                        else
                        {
                        curValueArea++;
                        }
                    }
                }
            </MudList>
        </MudPaper>
    </MudItem>
    
    <MudItem xs="4">
        <MudPaper Width="300px">
            <MudList Clickable="true" @bind-SelectedItem="selectedItemBuilding" @bind-SelectedValue="selectedValueBuilding">
                <MudListSubheader>
                    Total Building Count: @listBuildings.Count()
                </MudListSubheader>
                @{
                    foreach (var item in listBuildings)
                    {
                        if (item.Area == (listArea[(int)selectedValueArea]))
                        {
                        <MudListItem Text="@item.Name" Value="@curValueBuilding" OnClick="SetCountBuildings"></MudListItem>
                        curValueBuilding++;
                            
                        }
                    }
                }
            </MudList>
        </MudPaper>
    </MudItem>
</MudGrid>


@code
{
    int curValueArea = 0;
    MudListItem selectedItemArea;
    List<Area> listArea = new List<Area>();
    object selectedValueArea = 0;

    int curValueBuilding = 0;
    List<Building> listBuildings = new List<Building>();
    MudListItem selectedItemBuilding;
    object selectedValueBuilding = 0;
    
    
    protected override void OnInitialized()
    {

        GetAreas();
        GetBuildings();
        curValueArea = listArea.Count();
    }


    public void GetAreas()
    {
        SetCountBuildings();
        Owner owner = null;
        //list.AddRange(owner.Areas);
        listArea.Add(new Area{Name = "Test1",UpdatedUtc = DateTime.Now,Buildings = null,IsDeleted = false,Location = null,CreatedUtc = DateTime.Today, Owner = null});
        listArea.Add(new Area{Name = "Test2",UpdatedUtc = DateTime.Now,Buildings = null,IsDeleted = false,Location = null,CreatedUtc = DateTime.Today, Owner = null});
        listArea.Add(new Area{Name = "7",UpdatedUtc = DateTime.Now,Buildings = null,IsDeleted = false,Location = null,CreatedUtc = DateTime.Today, Owner = null});
        curValueArea = listArea.Count();

    }
    
    public void GetBuildings()
    {
        listBuildings.Clear();
    //list.AddRange(owner.Areas);
        listBuildings.Add(new Building{Name = "Test1",UpdatedUtc = DateTime.Now,IsDeleted = false,CreatedUtc = DateTime.Today, Address = "", Area = listArea[0], Roles = null, Id = new Guid{}});
        listBuildings.Add(new Building{Name = "Test4",UpdatedUtc = DateTime.Now,IsDeleted = false,CreatedUtc = DateTime.Today, Address = "", Area = listArea[0], Roles = null, Id = new Guid{}});
        listBuildings.Add(new Building{Name = "Test6",UpdatedUtc = DateTime.Now,IsDeleted = false,CreatedUtc = DateTime.Today, Address = "", Area = listArea[2], Roles = null, Id = new Guid{}});
        SetCountBuildings();
    }

    public void SetCountBuildings()
    {
        curValueBuilding = listBuildings.Count();
    }

    private void UpdateArea(Area area, ChangeEventArgs e)
        => area.Name = e.Value?.ToString() ?? null;
}