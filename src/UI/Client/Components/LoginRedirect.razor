    private async Task NavigateToLogin()
    {
        await base.OnAfterRenderAsync(true);
        if (NavigationManager.Uri.EndsWith("/login") || NavigationManager.Uri.EndsWith("/register"))
        {
            
        }
        else
        {
        NavigationManager.NavigateTo("/login");
            
        }

